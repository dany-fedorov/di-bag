{
  "$schema": "https://typedoc.org/schema.json",
  "name": "DI Bag API",
  "entryPoints": [
    "../../src/index.ts",
    "../../src/node.ts"
  ],
  "tsconfig": "../../tsconfig.build.json",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme"
  ],
  "readme": "none",
  "entryFileName": "index.md",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "gitRevision": "main",
  "disableGit": true,
  "displayBasePath": "../../src",
  "sourceLinkTemplate": "https://github.com/dany-fedorov/di-bag/blob/{gitRevision}/src/{path}#L{line}",
  "useCodeBlocks": true,
  "expandParameters": true,
  "parametersFormat": "table",
  "sidebar": {
    "pretty": true,
    "collapsed": true
  },
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": true
  },
  "treatWarningsAsErrors": true,
  "requiredToBeDocumented": [
    "Class",
    "Interface",
    "TypeAlias",
    "Variable",
    "Function"
  ]
}
