{
  "name": "di-bag",
  "version": "0.1.1",
  "description": "Type-checked dependency composition, private modules, and resource ownership for TypeScript apps and LLM harnesses.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc6 -p tsconfig.json",
    "typecheck:native": "tsc -p tsconfig.json",
    "build:native": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check:native": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-native-contracts.ts",
    "example:wbs": "bun run examples/wbs-scope.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc6 -p ./tsconfig.build.json",
    "benchmark:types": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/benchmark-types.ts",
    "benchmark:compiler-controls": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/benchmark-compiler-controls.ts",
    "benchmark:runtime": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/performance-evidence.ts --current",
    "evidence:platform": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/platform-evidence.ts",
    "platform:pin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/pin-platform-tools.ts",
    "check:platform": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/platform-evidence.ts --required",
    "docs:generate": "node tools/docs/generate.mjs",
    "docs:check": "node --test --test-isolation=none tools/docs/test/*.test.mjs && node tools/docs/generate.mjs --check && node tools/docs/site.mjs check",
    "docs:build": "node tools/docs/site.mjs build",
    "docs:dev": "node tools/docs/site.mjs dev",
    "docs:preview": "node tools/docs/site.mjs preview",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dany-fedorov/di-bag.git"
  },
  "homepage": "https://dany-fedorov.github.io/di-bag",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "di",
    "bag",
    "dependency-injection",
    "typescript",
    "modularity",
    "context-engineering",
    "agentic",
    "agentic-development",
    "llm",
    "harness",
    "agent-harness",
    "graph",
    "agent-graph",
    "evals",
    "metadata"
  ],
  "author": "Dany Fedorov",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "overrides": {
    "@typescript/old": "npm:typescript@6.0.3"
  }
}
