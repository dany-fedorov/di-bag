{
  "name": "di-bag",
  "version": "0.1.0",
  "description": "Type-checked dependency composition with lazy factories, forks, and optional disposal.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json",
    "example:wbs": "bun run examples/wbs-scope.ts",
    "build": "tsc -p ./tsconfig.build.json",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dany-fedorov/di-bag.git"
  },
  "homepage": "https://dany-fedorov.github.io/di-bag",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "di",
    "bag"
  ],
  "author": "Dany Fedorov",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "5.9.3"
  }
}
